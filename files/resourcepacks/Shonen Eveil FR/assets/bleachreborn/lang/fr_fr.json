  "text.bleachreborn.shikai_phrase_25": "Fracasse,",
  "text.bleachreborn.shikai_phrase_26": "Écrase tes ennemis,",
  "text.bleachreborn.shikai_phrase_27": "Démolis,",
  "text.bleachreborn.shikai_phrase_28": "Abats,",
  "text.bleachreborn.shikai_phrase_29": "Maintenant, tu vas déguster !",
  "text.bleachreborn.shikai_phrase_30": "Souffle en rafale,",
  "text.bleachreborn.shikai_phrase_31": "Fends,",
  "text.bleachreborn.shikai_phrase_32": "Tranche,",
  "text.bleachreborn.shikai_phrase_33": "Aiguise ta lame,",
  "text.bleachreborn.shikai_phrase_34": "Atteins les cieux,",
  "text.bleachreborn.shikai_phrase_35": "Voici",
  "text.bleachreborn.shikai_phrase_36": "Illumine,",
  "text.bleachreborn.shikai_phrase_37": "Brille,",
  "text.bleachreborn.shikai_phrase_38": "Perce les ténèbres,",
  "text.bleachreborn.shikai_phrase_39": "Intensifie-toi,",
  "text.bleachreborn.shikai_phrase_40": "Divin,",
  "text.bleachreborn.shikai_phrase_41": "Hé, écoute !",
  "text.bleachreborn.shikai_phrase_42": "Assombris le ciel,",
  "text.bleachreborn.shikai_phrase_43": "Fauche,",
  "text.bleachreborn.shikai_phrase_44": "Taille en pièces,",
  "text.bleachreborn.shikai_phrase_45": "Piège,",
  "text.bleachreborn.shikai_phrase_46": "Voile de ténèbres,",
  "text.bleachreborn.shikai_phrase_47": "Je vais te montrer le plus grand des cauchemars !",
  "text.bleachreborn.shikai_phrase_48": "Coupe profondément,",
  "text.bleachreborn.shikai_phrase_49": "Éveille-toi,",
  "text.bleachreborn.shikai_phrase_50": "Disperse les nuages,",
  "text.bleachreborn.shikai_phrase_51": "Embrasse le crépuscule,",
  "text.bleachreborn.shikai_phrase_52": "Scintille,",
  "text.bleachreborn.shikai_phrase_54": "Rassemble la tempête,",
  "text.bleachreborn.shikai_phrase_55": "Électrocute,",
  "text.bleachreborn.shikai_phrase_56": "Crépite,",
  "text.bleachreborn.shikai_phrase_57": "Éclair,",
  "text.bleachreborn.shikai_phrase_58": "Traverse le ciel,",
  "text.bleachreborn.shikai_phrase_60": "Frappe juste,",
  "text.bleachreborn.shikai_phrase_61": "Déchiquette,",
  "text.bleachreborn.shikai_phrase_62": "Avance,",
  "text.bleachreborn.shikai_phrase_63": "Dévaste,",
  "text.bleachreborn.shikai_phrase_64": "Fais trembler la Terre,",
  "text.bleachreborn.shikai_phrase_65": "Dégaine,",
  "text.bleachreborn.shikai_phrase_66": "Empale,",
  "text.bleachreborn.shikai_phrase_67": "Déchaîne les mers,",
  "text.bleachreborn.shikai_phrase_68": "Fais pleuvoir,",
  "text.bleachreborn.shikai_phrase_69": "Levez l'ancre,",
  "text.bleachreborn.shikai_phrase_70": "Sabre et abordage,",
  "text.bleachreborn.shikai_phrase_71": "Nage,",
  "text.bleachreborn.vizard.success": "Vous êtes devenu un Vizard avec succès"
}
